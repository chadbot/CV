\usepackage[letterpaper, hmargin=1in, vmargin=1in]{geometry}
\usepackage{fancyhdr,lastpage}
\usepackage{color}
\usepackage{tabularx}
\usepackage[hidelinks]{hyperref}
\usepackage{fontspec}
\usepackage{titlesec}
\usepackage{tabulary}
\usepackage{multirow}
\usepackage{etoolbox}
\usepackage{ifthen}
\usepackage{enumitem}
\usepackage{makecell}

% ----- FONT PREFERENCES ------------------------------------------------------------
% define font defaults
\setmainfont[
	Ligatures={NoRequired,NoCommon,NoContextual}, % more machine readable
 	BoldFont={EB Garamond-SemiBold}
]{EB Garamond}

% colour definitions
\definecolor{darkgrey}{rgb}{0.3,0.3,0.3}

% style to expand letter spacing
\newcommand{\spacedsc}[1]{\scshape\addfontfeatures{LetterSpace=#1}}

% ----- PAGE FORMATTING AND SPACING ----------------------------------------------------

% reduce hyphenation
\pretolerance=1000
% \tolerance=5000 
% \emergencystretch=2pt
% \exhyphenpenalty=100

% Page margins adjustments
\setlength{\topmargin}{-.25in}
\setlength{\headheight}{0in}
\setlength{\headsep}{0in}

% no default indentation
\setlength{\parindent}{0em}

% define table lengths
\newlength{\smallcolwidth}
\newlength{\tablewidth}
\newlength{\lindent}
\newlength{\rindent}

\setlength\tabcolsep{0em}
\setlength{\tablewidth}{1.0\textwidth}
\setlength{\smallcolwidth}{.17\tablewidth}
\setlength{\lindent}{1.5em}
\setlength{\rindent}{.5em}

% vertical space between items
\newskip\itemskip \itemskip=.5\baselineskip plus .2ex minus .2ex

% ----- SECTION FORMATTING -------------------------------------------------------------

% section formatting
\titlespacing{\section}{1em}{0ex}{-1ex}
\titleformat{\section}{\color{darkgrey}\scshape\raggedright\LARGE\spacedsc{10}}{}{}{}[]

% ----- HEADER AND FOOTER --------------------------------------------------------------

% remove hlines from header and footer
\renewcommand{\headrulewidth}{0pt}
\renewcommand{\footrulewidth}{0pt}

\newcommand{\Email}[1]{\href{mailto:#1}{#1}}
\newcommand{\URL}[1]{\href{#1}{#1}}

% remove page number
% \pagenumbering{gobble}

\newcommand{\addHeader}[3]{
	% {\centering\huge\textbf{#1} \\}
	\begin{tabularx}{\textwidth}{X X}
		\makecell[l]{#2} & \makecell[r]{#3} \\
	\end{tabularx}
}

\newcommand{\addFooter}[2]{
	\fancypagestyle{plain}{\fancyhf{}
	\lfoot{\ifthenelse{\value{page}=1}{}{#1}}
	\cfoot{\ifthenelse{\value{page}=1}{}{#2}}
	\rfoot{Page \thepage\ of \pageref{LastPage}}}
	\pagestyle{plain}
}

% ----- ADD ITEM COMMANDS ------------------------------------------------------------

% Add summary text block
% Use: \addSummary{Insert summary here.}
\newcommand{\addSummary}[1]{
	\vspace{\itemskip}
	\vbox{
		\begin{itemize}[nosep, leftmargin=\lindent, itemindent=0\lindent, 
			label={}, itemsep=.5\itemskip, rightmargin=2\rindent]
		\item{#1}
		\end{itemize}
	}
	% \vspace{\itemskip}
}

% Add education
% Use: \addDegree{year}{degree}{subject}{school}{location}{other details}
\newcommand{\addDegree}[6]{
	\vspace{\itemskip}
	\vbox{
		\begin{tabularx}{\tablewidth}{@{\hspace{\lindent}} X r}
		\textbf{#4}, #5 & #1 \\
		% {\textit{#2 in #3}} \\
		{#2 in #3} \\
		\end{tabularx}\ifblank{#6}{}{
			\begin{itemize}[nosep, leftmargin=1.75\lindent, rightmargin=\rindent]
				#6
			\end{itemize}
		 }
	}
}


% Add work experience
% Use: \addJob{years}{position}{employer}{city}{details}
\newcommand{\addJob}[5]{
	\vspace{\itemskip}
	\vbox{
		\begin{tabularx}{\tablewidth}{@{\hspace{\lindent}} X r}
		\textbf{#2} &  #1 \\
		% \ifblank{#3}{\textit{#4}}{\textit{#3, #4}} & \\
		\ifblank{#3}{#4}{#3, #4} & \\
		\end{tabularx}\ifblank{#5}{}{
			\begin{itemize}[nosep, leftmargin=1.75\lindent, rightmargin=\rindent]
				#5
			\end{itemize}
		 }
	}
}

% Add publications
% Use: \addPubs{\item publication}
\newcommand{\addPubs}[1]{
	\vspace{\itemskip}
	\vbox{
		\begin{itemize}[nosep, leftmargin=2\lindent, itemindent=-1\lindent, 
			label={}, itemsep=.5\itemskip, rightmargin=\rindent]
		#1
		\end{itemize}
	}
	\vspace{\itemskip}
}

% Add skill groups
% Use: \addJob{header}{\item skill}
\newcommand{\addSkillGroup}[2]{
	\vspace{\itemskip}
	\vbox{
		\begin{tabularx}{\tablewidth}{@{\hspace{\lindent}} X r}
		\textbf{#1} \\
		\end{tabularx}\ifblank{#2}{}{
			\begin{itemize}[nosep, leftmargin=1.75\lindent, rightmargin=\rindent]
				#2
			\end{itemize}
		 }
	}
}

% Add skills as description style list
% Use: \addSkills{\item[groupname] skills}
\newcommand{\addSkills}[1]{
	\vspace{\itemskip}
	\noindent\begin{description}[nosep, align=left, 
		labelindent=\lindent,
		leftmargin =\dimexpr \smallcolwidth + \lindent, 
		rightmargin=\rindent,
		labelwidth=\smallcolwidth, labelsep=0em, itemsep=\itemskip
	]
		#1
	\end{description}
	\vspace{\itemskip}
}
